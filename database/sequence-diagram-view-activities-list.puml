@startuml ViewActivitiesListSequence
actor "School Admin" as User
participant "Client UI\n(ActivityModal.js)" as UI
participant "Route\nGET /activities" as Route
participant "schoolAdminCalendarController" as Controller
participant "User Model" as UserModel
participant "Activity Model" as ActivityModel
database "Database" as DB

User -> UI: Click "Quản lý Môn Học" button
activate UI
UI -> UI: setActivityModalOpen(true)
UI -> UI: fetchActivities()
UI -> UI: setLoading(true)
UI -> Route: GET /school-admin/calendar/activities
activate Route

Route -> Controller: getAllActivities(req, res)
activate Controller

Controller -> UserModel: findById(userId).select('school_id')
activate UserModel
UserModel -> DB: Query user
DB -> UserModel: user document with school_id
UserModel -> Controller: schoolId
deactivate UserModel

Controller -> ActivityModel: find({school_id}).sort({activity_name: 1})
activate ActivityModel
ActivityModel -> DB: Query activities
DB -> ActivityModel: activities array
ActivityModel -> Controller: activities
deactivate ActivityModel

Controller -> Controller: Map activities to response format
Controller -> UI: res.json({success: true, data: activities})
deactivate Controller
deactivate Route

UI -> UI: setActivities(activitiesData)
UI -> UI: setLoading(false)
UI -> User: Display activities list
deactivate UI

@enduml












