@startuml AddParentSequence
actor "School Admin" as User
participant "UI" as UI
participant "Route" as Route
participant "Controller" as Controller
participant "Helper" as Helper
participant "Models" as Models
database "DB" as DB

User -> UI: Click "Add New Parent"
activate UI
UI -> User: Display form

User -> UI: Enter info and submit
UI -> UI: Validate form

alt Validation failed
    UI -> User: Show errors
    deactivate UI
else Validation passed
    UI -> Route: POST /student/:id/parents
    activate Route
    Route -> Controller: addParentForStudent()
    activate Controller
    
    Controller -> Models: findById(student_id)
    Models -> DB: Query student
    DB -> Models: student
    Models -> Controller: student
    
    alt Student not found
        Controller -> UI: 404 error
        deactivate Controller
        deactivate Route
        UI -> User: Show error
        deactivate UI
    else Validation passed
        Controller -> Helper: ensureParentAccount()
        activate Helper
        
        Helper -> Models: findOne({email/phone, role: 'parent'})
        Models -> DB: Query user
        DB -> Models: user or null
        Models -> Helper: userDoc
        
        alt User not found
            Helper -> Helper: Generate username & password
            Helper -> Models: create(User)
            Models -> DB: Insert user
            DB -> Models: newUser
            Models -> Helper: userDoc
        else User exists
            Helper -> Models: update(User)
            Models -> DB: Update user
            DB -> Models: updated
            Models -> Helper: done
        end
        
        Helper -> Models: findOne({user_id})
        Models -> DB: Query parent
        DB -> Models: parent or null
        Models -> Helper: parentDoc
        
        alt Parent not found
            Helper -> Models: create(Parent)
            Models -> DB: Insert parent
            DB -> Models: newParent
            Models -> Helper: parentDoc
        end
        
        Helper -> Models: findOne({parent_id, student_id})
        Models -> DB: Query link
        DB -> Models: link or null
        Models -> Helper: existingLink
        
        alt Link exists
            Helper -> Models: update(ParentStudent)
            Models -> DB: Update link
            DB -> Models: updated
            Models -> Helper: done
        else Link not exists
            Helper -> Models: create(ParentStudent)
            Models -> DB: Insert link
            DB -> Models: newLink
            Models -> Helper: created
        end
        
        alt New user created
            Helper -> Models: sendMail()
            Models -> DB: Send email
            DB -> Models: sent
            Models -> Helper: done
        end
        
        Helper -> Controller: {parent, user}
        deactivate Helper
        
        Controller -> UI: 201 success
        deactivate Controller
        deactivate Route
        UI -> UI: Refresh list
        UI -> User: Show success
        deactivate UI
    end
end

@enduml

