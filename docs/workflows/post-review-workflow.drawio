        <mxCell id="label-no" parent="1" style="text;html=1;align=center;fontSize=10;fontColor=#C62828;" value="No" vertex="1">
          <mxGeometry height="20" width="25" x="810" y="575" as="geometry" />
        </mxCell>
        <mxCell id="arrow11" edge="1" parent="1" source="approve-post" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="check-approved">
          <mxGeometry relative="1" as="geometry">
