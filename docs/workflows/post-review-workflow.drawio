<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36" version="29.2.1">
  <diagram id="post-workflow" name="Post Review &amp; Approval Workflow">
    <mxGraphModel dx="1703" dy="749" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="parent-lane" parent="1" style="swimlane;startSize=30;horizontal=1;fillColor=#E3F2FD;strokeColor=#333333;fontStyle=1;fontSize=13;" value="Parent" vertex="1">
          <mxGeometry height="180" width="1320" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="create-post" parent="parent-lane" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" value="Create post&#xa;(content + images)" vertex="1">
          <mxGeometry height="70" width="110" x="20" y="55" as="geometry" />
        </mxCell>
        <mxCell id="submit-post" parent="parent-lane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" value="Submit post" vertex="1">
