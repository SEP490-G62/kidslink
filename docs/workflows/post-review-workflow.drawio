        </mxCell>
        <mxCell id="view-posts" parent="parent-lane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" value="View approved&#xa;posts in feed" vertex="1">
          <mxGeometry height="50" width="110" x="1080" y="65" as="geometry" />
        </mxCell>
        <mxCell id="kidslink-lane" parent="1" style="swimlane;startSize=30;horizontal=1;fillColor=#FFF9C4;strokeColor=#333333;fontStyle=1;fontSize=13;" value="KidsLink" vertex="1">
          <mxGeometry height="240" width="1320" x="40" y="220" as="geometry" />
        </mxCell>
        <mxCell id="receive-post" parent="kidslink-lane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" value="Receive post" vertex="1">
          <mxGeometry height="50" width="100" x="170" y="70" as="geometry" />
        </mxCell>
        <mxCell id="save-pending" parent="kidslink-lane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" value="Save post with&#xa;status=&#39;pending&#39;" vertex="1">
          <mxGeometry height="50" width="110" x="310" y="70" as="geometry" />
        </mxCell>
        <mxCell id="put-queue" parent="kidslink-lane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" value="Add to&#xa;review queue" vertex="1">
          <mxGeometry height="50" width="100" x="460" y="70" as="geometry" />
        </mxCell>
        <mxCell id="notify-submitted" parent="kidslink-lane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#333333;fontSize=11;" value="Notify parent:&#xa;Submitted" vertex="1">
          <mxGeometry height="50" width="110" x="310" y="150" as="geometry" />
        </mxCell>
        <mxCell id="check-approved" parent="kidslink-lane" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#333333;fontSize=11;" value="Is approved?" vertex="1">
          <mxGeometry height="70" width="100" x="945" y="65" as="geometry" />
        </mxCell>
        <mxCell id="show-public" parent="kidslink-lane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" value="Display post&#xa;publicly" vertex="1">
          <mxGeometry height="50" width="110" x="1080" y="75" as="geometry" />
        </mxCell>
        <mxCell id="hide-post" parent="kidslink-lane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#333333;fontSize=11;" value="Hide post from&#xa;public feed" vertex="1">
          <mxGeometry height="50" width="100" x="710" y="75" as="geometry" />
        </mxCell>
        <mxCell id="label-pending" parent="kidslink-lane" style="text;html=1;align=center;fontSize=10;fontColor=#C62828;" value="No" vertex="1">
          <mxGeometry height="20" width="25" x="920" y="75" as="geometry" />
        </mxCell>
        <mxCell id="label-approved" parent="kidslink-lane" style="text;html=1;align=center;fontSize=10;fontColor=#2E7D32;" value="Yes" vertex="1">
          <mxGeometry height="20" width="30" x="1040" y="100" as="geometry" />
        </mxCell>
        <mxCell id="schooladmin-lane" parent="1" style="swimlane;startSize=30;horizontal=1;fillColor=#E1F5FE;strokeColor=#333333;fontStyle=1;fontSize=13;" value="School Admin" vertex="1">
          <mxGeometry height="200" width="1320" x="40" y="460" as="geometry" />
        </mxCell>
        <mxCell id="view-queue" parent="schooladmin-lane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" value="View review&#xa;queue" vertex="1">
          <mxGeometry height="50" width="100" x="460" y="60" as="geometry" />
