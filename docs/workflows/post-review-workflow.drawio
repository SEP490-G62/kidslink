        <mxCell id="approve-post" parent="schooladmin-lane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#333333;fontSize=11;" value="Approve post&#xa;(status=&#39;approved&#39;)" vertex="1">
          <mxGeometry height="50" width="120" x="935" y="60" as="geometry" />
        </mxCell>
        <mxCell id="reject-post" parent="schooladmin-lane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#333333;fontSize=11;" value="Keep pending or&#xa;notify rejection" vertex="1">
