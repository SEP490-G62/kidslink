<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36" version="29.2.1">
  <diagram id="attendance-workflow" name="Attendance Workflow">
    <mxGraphModel dx="1281" dy="562" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="teacher-lane" parent="1" style="swimlane;startSize=30;horizontal=1;fillColor=#E3F2FD;strokeColor=#333333;fontStyle=1;fontSize=13;" value="Teacher" vertex="1">
          <mxGeometry height="120" width="760" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="start" parent="teacher-lane" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" value="Start - Open&#xa;attendance" vertex="1">
          <mxGeometry height="60" width="100" x="20" y="45" as="geometry" />
        </mxCell>
        <mxCell id="select" parent="teacher-lane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" value="Select class and&#xa;attendance date" vertex="1">
          <mxGeometry height="50" width="120" x="150" y="50" as="geometry" />
        </mxCell>
        <mxCell id="mark" parent="teacher-lane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" value="Mark status&#xa;for each student" vertex="1">
          <mxGeometry height="50" width="120" x="300" y="45" as="geometry" />
        </mxCell>
        <mxCell id="arrow1" edge="1" parent="teacher-lane" source="start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="select">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kidslink-lane" parent="1" style="swimlane;startSize=30;horizontal=1;fillColor=#FFF9C4;strokeColor=#333333;fontStyle=1;fontSize=13;" value="KidsLink" vertex="1">
          <mxGeometry height="180" width="760" x="40" y="160" as="geometry" />
        </mxCell>
        <mxCell id="load" parent="kidslink-lane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" value="Load student list" vertex="1">
          <mxGeometry height="50" width="120" x="150" y="90" as="geometry" />
        </mxCell>
        <mxCell id="display" parent="kidslink-lane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" value="Display form&#xa;with student list" vertex="1">
          <mxGeometry height="50" width="120" x="300" y="90" as="geometry" />
        </mxCell>
        <mxCell id="validate" parent="kidslink-lane" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#333333;" value="Validate?" vertex="1">
          <mxGeometry height="70" width="80" x="580" y="30" as="geometry" />
        </mxCell>
        <mxCell id="save" parent="kidslink-lane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" value="Save to&#xa;database" vertex="1">
          <mxGeometry height="50" width="100" x="580" y="120" as="geometry" />
        </mxCell>
        <mxCell id="arrow2" edge="1" parent="kidslink-lane" source="load" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="display">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow3" edge="1" parent="kidslink-lane" source="validate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="save" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow-load" edge="1" parent="1" source="load" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="select">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow-display" edge="1" parent="1" source="display" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="mark">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow-validate" edge="1" parent="1" source="validate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="mark" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="parent-lane" parent="1" style="swimlane;startSize=30;horizontal=1;fillColor=#E8F5E9;strokeColor=#333333;fontStyle=1;fontSize=13;" value="Parent" vertex="1">
          <mxGeometry height="120" width="760" x="40" y="340" as="geometry" />
        </mxCell>
        <mxCell id="receive" parent="parent-lane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" value="Receive&#xa;notification" vertex="1">
          <mxGeometry height="50" width="100" x="440" y="60" as="geometry" />
        </mxCell>
        <mxCell id="end" parent="parent-lane" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" value="Finish" vertex="1">
          <mxGeometry height="60" width="80" x="670" y="55" as="geometry" />
        </mxCell>
        <mxCell id="arrow-notify" edge="1" parent="1" source="save" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="receive">
          <mxGeometry relative="1" as="geometry" />
