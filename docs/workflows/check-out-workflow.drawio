      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="teacher-lane" parent="1" style="swimlane;startSize=30;horizontal=1;fillColor=#E3F2FD;strokeColor=#333333;fontStyle=1;fontSize=13;" value="Teacher" vertex="1">
